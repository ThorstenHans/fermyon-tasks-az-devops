{
  "manifestVersion": 1,
  "id": "spin-tasks",
  "name": "Spin",
  "version": "0.4.11",
  "publisher": "thorstenhans",
  "public": true,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "description": "Azure DevOps tasks for Spin",
  "content": {
    "details": {
      "path": "DETAILS.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "categories": ["Azure Pipelines"],
  "icons": {
    "default": "assets/images/spin-icon.png"
  },
  "files": [
    {
      "path": "spin-tool"
    },
    {
      "path": "spin-build"
    },
    {
      "path": "spin-command"
    },
    {
      "path": "spin-install-plugin"
    },
    {
      "path": "spin-version"
    },
    {
      "path": "assets/docs/spin-tasks.png",
      "addressable": true
    },
    {
      "path": "assets/docs/spin-command-example.png",
      "addressable": true
    },
    {
      "path": "assets/docs/spin-tool-installer-version.png",
      "addressable": true
    },
    {
      "path": "assets/docs/spin-version-output.png",
      "addressable": true
    }
  ],
  "branding": {
    "color": "rgb(14, 9, 45)",
    "theme": "dark"
  },
  "contributions": [
    {
      "id": "spin-tool",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "spin-tool"
      }
    },
    {
      "id": "spin-build",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "spin-build"
      }
    },
    {
      "id": "spin-version",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "spin-version"
      }
    },
    {
      "id": "spin-command",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "spin-command"
      }
    },
    {
      "id": "spin-install-plugin",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "spin-install-plugin"
      }
    }
  ],
  "screenshots": [
    {
      "path": "assets/docs/fermyon-tasks.png"
    },
    {
      "path": "assets/docs/spin-command-example.png"
    },
    {
      "path": "assets/docs/spin-tool-installer-version.png"
    },
    {
      "path": "assets/docs/spin-version-output.png"
    }
  ],
  "links": {
    "support": {
      "uri": "https://github.com/ThorstenHans/fermyon-tasks-az-devops/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/ThorstenHans/fermyon-tasks-az-devops"
  },
  "tags": ["spin", "webassembly", "wasm", "build"]
}
